---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FigNexus from '../../components/figures/FigNexus.astro';
import FigSafePaste from '../../components/figures/FigSafePaste.astro';
import FigPlacement from '../../components/figures/FigPlacement.astro';
import FigInsurance from '../../components/figures/FigInsurance.astro';
import FigDuolingo from '../../components/figures/FigDuolingo.astro';

const figures: Record<string, any> = {
  nexusims: FigNexus,
  safepaste: FigSafePaste,
  'ai-placement': FigPlacement,
  'insurance-analytics': FigInsurance,
  'duolingo-onboarding': FigDuolingo,
};

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const Figure = figures[project.id];
---

<Base title={`${d.title} — case study · Aditya Singh`} description={d.summary}>
  <article>
    <header class="cs-head wrap">
      <a href="/#work" class="meta" style="text-decoration:none">← Index</a>
      <h1 class="cs-title">{d.title}</h1>
      <p class="cs-thesis">{d.tagline}</p>
    </header>

    <div class="wrap">
      <div class="spec" style="margin-bottom:2.5rem">
        <div class="spec-bar">
          <span class="meta">Fig. 1 — {d.category}</span>
          <span class="meta">{d.year}</span>
        </div>
        <div class="spec-fig" style="border-left:none; padding:clamp(1.25rem,3vw,2.5rem)">
          {Figure && <Figure />}
        </div>
      </div>

      <dl class="kv" style="margin-bottom:2.5rem">
        {d.role && <><dt>Role</dt><dd>{d.role}</dd></>}
        {d.timeframe && <><dt>Timeframe</dt><dd>{d.timeframe}</dd></>}
        <dt>Stack</dt><dd>{d.tech.join(' · ')}</dd>
        {d.repo && <><dt>Source</dt><dd><a href={d.repo} target="_blank" rel="noopener" class="signal">{d.repo.replace('https://', '')} ↗</a></dd></>}
      </dl>

      <div class="figures" style="margin-bottom:2.5rem">
        {d.metrics.map((m) => (
          <div>
            <div class="figure-n">{m.value}</div>
            <div class="figure-l">{m.label}</div>
          </div>
        ))}
      </div>

      {d.artifacts && (
        <section style="margin-bottom:2.5rem">
          <h2 class="meta signal" style="margin-bottom:0.5rem">Artifacts</h2>
          <ul class="linklist">
            {d.artifacts.map((a) => (
              <li>
                <a href={a.href} target="_blank" rel="noopener">
                  <span>
                    {a.label}
                    {a.note && <span class="meta" style="display:block; margin-top:0.15rem">{a.note}</span>}
                  </span>
                  <span class="k">Open ↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="prose">
        <Content />
      </div>

      <div style="border-top:1px solid var(--rule); margin-top:3rem; padding:2rem 0 4rem">
        <a href="/#work" class="btn">← All work</a>
      </div>
    </div>
  </article>
</Base>
