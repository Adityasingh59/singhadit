---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FigNexus from '../../components/figures/FigNexus.astro';
import FigSafePaste from '../../components/figures/FigSafePaste.astro';
import FigPlacement from '../../components/figures/FigPlacement.astro';
import FigInsurance from '../../components/figures/FigInsurance.astro';
import FigDuolingo from '../../components/figures/FigDuolingo.astro';

// Supporting diagrams. They sit beside the story, never ahead of it.
const figures: Record<string, any> = {
  nexusims: FigNexus,
  safepaste: FigSafePaste,
  'ai-placement': FigPlacement,
  'insurance-analytics': FigInsurance,
  'duolingo-onboarding': FigDuolingo,
};

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const Figure = figures[project.id];
---

<Base title={`${d.title} — case study · Aditya Singh`} description={d.summary} image={d.ogImage}>
  <article>
    <header class="cs-head wrap">
      <a href="/#work" class="cs-back">← All case studies</a>
      <p class="eyebrow">{d.category}</p>
      <h1 class="cs-title" transition:name={`title-${project.id}`}>{d.title}</h1>
      <p class="cs-thesis">{d.tagline}</p>
    </header>

    <div class="wrap">
      <section class="cs-summary" aria-label="Summary">
        <dl class="kv">
          {d.role && <><dt>My role</dt><dd>{d.role}</dd></>}
          {d.timeframe && <><dt>Timeframe</dt><dd>{d.timeframe}</dd></>}
          {d.skills.length > 0 && <><dt>Skills shown</dt><dd>{d.skills.join(' · ')}</dd></>}
        </dl>
        <div class="figures">
          {d.metrics.map((m) => (
            <div>
              <div class="figure-n">{m.value}</div>
              <div class="figure-l">{m.label}</div>
            </div>
          ))}
        </div>
      </section>

      <div class="cs-body">
        <div class="prose">
          <Content />
        </div>

        <aside class="cs-aside">
          {d.artifacts && (
            <section>
              <h2>Artifacts</h2>
              <ul class="linklist">
                {d.artifacts.map((a) => (
                  <li>
                    <a href={a.href} target="_blank" rel="noopener">
                      <span>
                        {a.label}
                        {a.note && <span class="muted" style="display:block; font-size:0.85rem; margin-top:0.15rem">{a.note}</span>}
                      </span>
                      <span class="k">Open ↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {Figure && (
            <figure class="cs-fig">
              <Figure />
              <figcaption>Supporting diagram</figcaption>
            </figure>
          )}

          <section>
            <h2>Built with</h2>
            <p class="built-with">{d.tech.join(' · ')}</p>
            {d.repo && (
              <p class="built-with" style="margin-top:0.5rem">
                <a href={d.repo} target="_blank" rel="noopener" class="signal">View source ↗</a>
              </p>
            )}
          </section>

          <a href="/#work" class="btn">← All case studies</a>
        </aside>
      </div>
    </div>
  </article>
</Base>
