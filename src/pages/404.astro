---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Aditya Singh" description="No such page.">
  <section class="wrap" style="padding-block: clamp(4rem, 14vh, 9rem)">
    <span class="meta signal">Error 404</span>
    <h1 class="display" style="margin: 1rem 0">No such page.</h1>
    <p class="body-lg" style="margin-bottom: 2rem">
      The address is wrong, or the thing that lived here has been cut. Both happen.
    </p>
    <a href="/" class="btn btn--primary">← Back to home</a>
  </section>
</Base>
