---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroPortrait from '../assets/aditya-hero.jpg';
import Base from '../layouts/Base.astro';
import FigNexus from '../components/figures/FigNexus.astro';
import FigSafePaste from '../components/figures/FigSafePaste.astro';
import FigPlacement from '../components/figures/FigPlacement.astro';
import FigInsurance from '../components/figures/FigInsurance.astro';
import FigDuolingo from '../components/figures/FigDuolingo.astro';

const figures: Record<string, any> = {
  nexusims: FigNexus,
  safepaste: FigSafePaste,
  'ai-placement': FigPlacement,
  'insurance-analytics': FigInsurance,
  'duolingo-onboarding': FigDuolingo,
};

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const record = [
  { year: '2025 —', what: 'MS Project Management (STEM), NYU', note: 'GPA 3.91. Building NexusIMS and SafePaste alongside coursework.' },
  { year: '2024 – 25', what: 'Business Strategy Analyst, Faclon Labs', note: 'Funded IoT startup. Owned a supply-chain product end to end; +20% reliability.' },
  { year: '2024 – 25', what: 'PG Diploma, Data Science — SDBI', note: 'CGPA 9.05. ML, NLP, predictive modelling.' },
  { year: '2023 – 24', what: 'Product Lead, AI Placement System', note: 'Four people, three sprints, twelve UAT cases. First time owning a product.' },
  { year: '2021 – 24', what: 'BS Computer Science, KC College Mumbai', note: 'CGPA 9.73. The reason I can read the codebase I am speccing.' },
];
---

<Base>
  <!-- ============ TITLE BLOCK — renders without JS ============ -->
  <header class="hero wrap">
    <div class="hero-top">
      <span class="meta">Portfolio · Product</span>
      <span class="meta status"><span class="status-dot"></span>Open to 2026 roles</span>
    </div>

    <h1 class="display hero-display">I write the spec,<br />then I build it.</h1>

    <div class="hero-grid">
      <div>
        <p class="body-lg">
          I'm a product manager with a computer science degree, which means I can write
          the PRD and then go implement it. I've shipped a multi-tenant inventory platform,
          an on-device privacy tool, and an NLP screening system that cut manual work by 60%.
          Right now I'm at NYU finishing a master's and building two products in parallel.
        </p>

        <dl class="kv" style="margin-top: 1.75rem">
          <dt>Role</dt><dd>Product Manager · Business Analyst · Data PM</dd>
          <dt>Based</dt><dd>New York City — open to remote and hybrid</dd>
          <dt>Now</dt><dd>MS Project Management (STEM), NYU — GPA 3.91</dd>
          <dt>Before</dt><dd>Business Strategy Analyst, Faclon Labs</dd>
          <dt>Work auth</dt><dd>F-1 · STEM OPT eligible</dd>
        </dl>

        <div style="display:flex; gap:0.6rem; flex-wrap:wrap; margin-top:1.75rem">
          <a href="#work" class="btn btn--signal">Read the work</a>
          <a href="mailto:singhadit.505@gmail.com" class="btn">Email me</a>
        </div>
      </div>

      <figure class="hero-portrait">
        <Image
          src={heroPortrait}
          alt="Aditya Singh"
          widths={[320, 640, 960]}
          sizes="(max-width: 860px) 100vw, 320px"
          fetchpriority="high"
          loading="eager"
        />
        <figcaption class="figcap">
          <span>Fig. 0 — A. Singh</span>
          <span>NYC</span>
        </figcaption>
      </figure>
    </div>
  </header>

  <!-- ============ §01 WORK ============ -->
  <section class="clause wrap" id="work">
    <div class="clause-head">
      <span class="clause-num">§ 01</span>
      <div>
        <h2 class="h2">Work</h2>
        <p class="body-lg" style="margin-top:0.5rem">
          Four systems I built and one experiment I designed. Each started as a written
          problem statement and ended as something with numbers attached. The figures are
          drawn from the real repositories and the real design doc, not decoration.
        </p>
      </div>
    </div>

    {projects.map((p, i) => {
      const Figure = figures[p.id];
      return (
        <article class="spec rise" id={p.id}>
          <div class="spec-bar">
            <span class="meta">Spec / {String(i + 1).padStart(2, '0')} — {p.data.category}</span>
            <span class="meta">{p.data.year}</span>
          </div>
          <div class="spec-body">
            <div class="spec-text">
              <h3 class="spec-title"><a href={`/work/${p.id}`}>{p.data.title}</a></h3>
              <p class="spec-thesis">{p.data.tagline}</p>

              <div class="figures">
                {p.data.metrics.map((m) => (
                  <div>
                    <div class="figure-n">{m.value}</div>
                    <div class="figure-l">{m.label}</div>
                  </div>
                ))}
              </div>

              <div class="stack-run" style="margin-bottom:1.25rem">
                {p.data.tech.map((t) => <span>{t}</span>)}
              </div>

              <a href={`/work/${p.id}`} class="readmore">
                {p.data.kind === 'experiment' ? 'Read the design' : 'Read the case study'} →
              </a>

              {p.data.artifacts && (
                <p class="meta" style="margin-top:0.9rem">
                  Artifacts — {p.data.artifacts.map((a) => a.label).join(' · ')}
                </p>
              )}
            </div>
            <div class="spec-fig">
              {Figure && <Figure />}
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <!-- ============ §02 RECORD ============ -->
  <section class="clause wrap" id="record">
    <div class="clause-head">
      <span class="clause-num">§ 02</span>
      <div>
        <h2 class="h2">Record</h2>
        <p class="body-lg" style="margin-top:0.5rem">
          Computer science, then strategy, then product. In that order, on purpose.
        </p>
      </div>
    </div>

    <table class="ruled rise">
      <thead>
        <tr><th style="width:7rem">Year</th><th style="width:22rem">What</th><th class="c-note">Note</th></tr>
      </thead>
      <tbody>
        {record.map((r) => (
          <tr>
            <td class="c-year">{r.year}</td>
            <td class="c-what">{r.what}</td>
            <td class="c-note">{r.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- ============ §03 APPROACH ============ -->
  <section class="clause wrap" id="approach">
    <div class="clause-head">
      <span class="clause-num">§ 03</span>
      <div>
        <h2 class="h2">Approach</h2>
      </div>
    </div>

    <div class="doc rise">
      <aside class="doc-margin">
        <p>On method</p>
        <p style="margin-top:0.75rem" class="signal">↓</p>
      </aside>
      <div class="doc-body">
        <p>
          I started in computer science and spent three years learning how systems actually
          fail. Then I found out the expensive failures are almost never technical. They're
          a team shipping the wrong thing quickly, or arguing for six weeks because nobody
          wrote down what "churn" means.
        </p>
        <p>
          So my process is boring on purpose. <strong>Write the problem down first.</strong> At
          Faclon Labs that meant sitting with the supply-chain team until the actual constraint
          surfaced, which was reconciliation lag, not forecasting. On the insurance dashboard it
          meant refusing to build a chart until eight metrics had agreed formulas. That
          argument was the deliverable; the dashboard was just the artifact.
        </p>
        <p>
          <strong>Then sequence honestly.</strong> RICE is not a magic ranking, it's a way to make
          the cut defensible when scope pressure arrives mid-sprint — and it always does. On the
          placement system it's why we shipped the parser and the ranker before anyone's
          favourite analytics view.
        </p>
        <p>
          <strong>Then build it.</strong> This is the part I'd rather not outsource. NexusIMS is
          165 source files I wrote against a system design I wrote, and speccing a module
          marketplace teaches you things about permission scoping that no amount of roadmap
          review does. I don't think every PM needs to code. I do think the ones who can
          write better specs.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ §04 CONTACT ============ -->
  <section class="clause wrap" id="contact">
    <div class="clause-head">
      <span class="clause-num">§ 04</span>
      <div>
        <h2 class="h2">Contact</h2>
        <p class="body-lg" style="margin-top:0.5rem">
          I'm looking for product, business analyst, and data PM roles for 2026.
          If you have a problem that isn't well defined yet, that's the interesting kind.
        </p>
      </div>
    </div>

    <div class="colophon rise">
      <form id="contactForm">
        <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
        <input type="hidden" name="subject" value="New message from singhadit.com" />
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <button type="submit" class="btn btn--signal">Send</button>
        <p class="form-note" id="formNote" role="status" aria-live="polite"></p>
      </form>

      <div>
        <ul class="linklist">
          <li><a href="mailto:singhadit.505@gmail.com"><span>singhadit.505@gmail.com</span><span class="k">Email</span></a></li>
          <li><a href="https://www.linkedin.com/in/singh-aditya59/" target="_blank" rel="noopener"><span>singh-aditya59</span><span class="k">LinkedIn</span></a></li>
          <li><a href="https://github.com/Adityasingh59" target="_blank" rel="noopener"><span>Adityasingh59</span><span class="k">GitHub</span></a></li>
          <li><a href="/resume.pdf" download><span>Curriculum vitae</span><span class="k">PDF</span></a></li>
        </ul>
        <p class="meta" style="margin-top:1.5rem; line-height:1.8">
          Based in New York City<br />
          Open to remote · hybrid · on-site<br />
          F-1 visa · STEM OPT eligible
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const note = document.getElementById('formNote');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!note) return;
    const data = new FormData(form);
    const key = data.get('access_key');

    if (!key || key === 'YOUR_WEB3FORMS_ACCESS_KEY') {
      const name = encodeURIComponent(String(data.get('name') || ''));
      const msg = encodeURIComponent(String(data.get('message') || ''));
      note.textContent = 'Opening your email client…';
      note.className = 'form-note ok';
      window.location.href = `mailto:singhadit.505@gmail.com?subject=Portfolio enquiry from ${name}&body=${msg}`;
      return;
    }

    note.textContent = 'Sending…';
    note.className = 'form-note';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message || 'failed');
      note.textContent = 'Sent. I’ll reply shortly.';
      note.className = 'form-note ok';
      form.reset();
    } catch (err) {
      note.textContent = 'Failed to send — email singhadit.505@gmail.com directly.';
      note.className = 'form-note error';
    }
  });
</script>
